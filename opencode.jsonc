{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "agent": {
    "analytics-dbt": {
      "mode": "subagent",
      "permission": {
        "bash": {
          "*": "ask",
          "git *": "allow",
          "git commit *": "ask",
          "git push *": "deny",
          "grep *": "allow"
        }
      }
    },
    "evaluation-cplusplus": {
      "model": "openai/gpt-5.5",
      "permission": {
        "bash": {
          "*": "ask",
          "git *": "allow",
          "git commit *": "ask",
          "git push *": "deny",
          "grep *": "allow"
        }
      }
    }
  }
}
